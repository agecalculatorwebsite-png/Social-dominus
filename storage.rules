rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Workspaces media storage
    match /workspaces/{workspaceId}/media/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.resource.size < 100 * 1024 * 1024 // 100MB max
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
      allow delete: if isSignedIn();
    }

    // User personal media uploads
    match /users/{userId}/media/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId)
        && request.resource.size < 100 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
      allow delete: if isOwner(userId);
    }
  }
}
